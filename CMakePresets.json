{
  "version": 8,
  "configurePresets": [
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (vcpkg)",
      "description": "Build with Visual Studio MSVC toolchain using vcpkg dependencies",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug (vcpkg)",
      "description": "Debug build with Visual Studio MSVC toolchain using vcpkg dependencies",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "msvc-release-static-crt",
      "displayName": "MSVC Release static CRT (vcpkg)",
      "description": "Release build with statically-linked C runtime",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VHG_USE_STATIC_CRT": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release (vcpkg)",
      "description": "Release build with Ninja generator using vcpkg dependencies",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ]
}